{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pqid-bench.org/schemas/1.0.0/response.schema.json",
  "title": "PQID-Bench canonical response",
  "type": "object",
  "required": ["prompt_id"],
  "properties": {
    "prompt_id": {"type": "string", "minLength": 1},
    "model": {"type": "string"},
    "provider": {"type": "string"},
    "generated_text": {"type": ["string", "null"]},
    "generated_code": {"type": ["string", "null"]},
    "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "error": {"type": ["object", "null"]}
  },
  "additionalProperties": true
}
